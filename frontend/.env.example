# Daycare Management System Frontend Configuration
# Loaded via dotenv and Vite environment manager

# Base URL for the .NET Backend API (when empty, uses Vite proxy /api -> http://localhost:5107)
VITE_API_BASE_URL=http://localhost:5107
VITE_API_URL=

# Center facility and organization identification
VITE_FACILITY_ID=DC-CENTRAL-01
VITE_APP_TITLE="Daycare Management System"
